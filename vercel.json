{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mrspinkagency.com"
        }
      ],
      "destination": "https://mrspinkagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/el-desayuno-prueba",
      "destination": "/el-desayuno",
      "permanent": true
    },
    {
      "source": "/el-desayuno-prueba.html",
      "destination": "/el-desayuno",
      "permanent": true
    }
  ]
}
